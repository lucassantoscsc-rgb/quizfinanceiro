{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tinofinancas.com.br"
        }
      ],
      "destination": "/app.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    }
  ]
}
